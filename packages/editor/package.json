{
  "name": "@keenmate/web-editor",
  "version": "0.0.1",
  "description": "KeenMate Web Editor — a framework-agnostic WYSIWYG / Markdown editor built on ProseMirror.",
  "type": "module",
  "main": "./dist/web-editor.umd.js",
  "module": "./dist/web-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web-editor.js",
      "require": "./dist/web-editor.umd.js",
      "default": "./dist/web-editor.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "author": "Keenmate s.r.o.",
  "license": "MIT",
  "homepage": "https://keenmate.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/keenmate/web-editor.git",
    "directory": "packages/editor"
  },
  "scripts": {
    "dev": "vite --port 21113",
    "build": "npm run clean && vite build",
    "build:types": "tsc",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@keenmate/web-components-core": "1.0.0-rc10",
    "markdown-it": "^14.1.0",
    "prismjs": "^1.29.0",
    "prosemirror-commands": "^1.5.2",
    "prosemirror-history": "^1.3.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.13.0",
    "prosemirror-model": "^1.19.0",
    "prosemirror-schema-list": "^1.3.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.3.0",
    "prosemirror-transform": "^1.8.0",
    "prosemirror-view": "^1.32.0"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  }
}
