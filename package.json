{
  "name": "@keenmate/web-editor",
  "version": "1.0.0-rc01",
  "description": "Keenmate Web Editor — a framework-agnostic WYSIWYG / Markdown editor built on ProseMirror.",
  "type": "module",
  "license": "MIT",
  "author": "Keenmate s.r.o.",
  "homepage": "https://github.com/keenmate/web-editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenmate/web-editor.git"
  },
  "keywords": [
    "wysiwyg",
    "markdown",
    "editor",
    "prosemirror",
    "web-components",
    "custom-elements",
    "keenmate",
    "bliss",
    "km-editor"
  ],
  "main": "./dist/web-editor.umd.js",
  "module": "./dist/web-editor.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "web-types": "web-types.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web-editor.js",
      "require": "./dist/web-editor.umd.js",
      "default": "./dist/web-editor.js"
    },
    "./style.css": "./dist/style.css",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "custom-elements.json",
    "web-types.json",
    "vscode.html-custom-data.json",
    "vscode.css-custom-data.json",
    "!**/CLAUDE.md",
    "!**/.claude"
  ],
  "sideEffects": [
    "./dist/*.js",
    "./dist/*.css"
  ],
  "kmwc": {
    "title": "Web Editor",
    "tagline": "A framework-agnostic WYSIWYG / Markdown editor built on ProseMirror, shipped as the <km-editor> Web Component.",
    "tag": "km-editor",
    "prefix": "km",
    "library": {
      "globalName": "WebEditor",
      "fileName": "web-editor",
      "typesPluginConfig": {
        "include": [
          "src"
        ],
        "exclude": [
          "src/dev",
          "test"
        ]
      }
    },
    "ports": {
      "dev": 12700,
      "image": 12710
    }
  },
  "scripts": {
    "dev": "vite",
    "analyze": "cem analyze",
    "build": "npm run clean:dist && npm run analyze && tsc --noEmit && vite build",
    "build:examples": "vite build --mode examples",
    "preview:examples": "vite preview --mode examples",
    "typecheck": "tsc --noEmit",
    "doctor": "kmwc doctor",
    "prepublishOnly": "npm run clean:dist && npm run build",
    "clean:dist": "node -e \"for (const p of ['dist']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "clean": "node -e \"for (const p of ['dist','dist-examples']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@keenmate/web-components-core": "file:../web-components-core",
    "markdown-it": "^14.1.0",
    "prismjs": "^1.29.0",
    "prosemirror-commands": "^1.5.2",
    "prosemirror-history": "^1.3.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.13.0",
    "prosemirror-model": "^1.19.0",
    "prosemirror-schema-list": "^1.3.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.3.0",
    "prosemirror-transform": "^1.8.0",
    "prosemirror-view": "^1.32.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@keenmate/web-components-devkit": "^1.0.0-rc01",
    "@playwright/test": "^1.60.0",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "publishConfig": {
    "access": "public"
  }
}
